# .env.example
# Landing Page Configuration

# Contact Form Settings
CONTACT_FORM_ENDPOINT=https://api.example.com/contact
FORM_VALIDATION_STRICT=true
FORM_AUTO_RESET_DELAY=3000

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=
HOTJAR_ID=

# Social Links
LINKEDIN_URL=https://linkedin.com/in/username
GITHUB_URL=https://github.com/username

# Site Configuration
SITE_NAME=I.S.C. José Gregorio Hernández Trejo | Consultoría de Software
SITE_DESCRIPTION=Arquitectura de software escalable para PYMES
SITE_AUTHOR=I.S.C. José Gregorio Hernández Trejo
SITE_EMAIL=contacto@jghernandez.tech
SITE_LOCATION=Querétaro, México

# Brand Colors (HEX)
BRAND_DARK=#0A192F
BRAND_ACCENT=#00E676
BRAND_SECONDARY=#8892B0
BRAND_SURFACE=#112240
BRAND_LIGHTER=#233554

# Email Settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REPLY_TO_EMAIL=contacto@jghernandez.tech

# Development
DEBUG=false
DEVELOPMENT_MODE=false
